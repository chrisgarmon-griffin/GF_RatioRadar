# Provider selection: fixture by default. Only HouseCanary has a callable adapter.
LISTINGS_PROVIDER=fixture
RENT_PROVIDER=fixture
RATE_PROVIDER=fixture

# HouseCanary requires demo mode false and non-fictional listing inputs.
# Live listing feed is not built. BankingBridge is a blocked prototype, not live pricing.
CONSTELLATION_API_KEY=
HOUSECANARY_API_SECRET=
HOUSECANARY_API_KEY=
BANKINGBRIDGE_API_KEY=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy optional value; the shared footer uses verified company NMLS 1120111.
NEXT_PUBLIC_NMLS=
# Griffin application URL shown after a lead is submitted (optional)
NEXT_PUBLIC_PREQUAL_URL=

# Demo mode is on unless this is "false": noindex, sample-data banner, leads not stored
NEXT_PUBLIC_DEMO_MODE=true
# Where leads go (POSTed as JSON). Required in production; serverless hosts have no durable disk.
LEAD_WEBHOOK_URL=
