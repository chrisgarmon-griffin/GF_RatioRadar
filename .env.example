# Provider selection: "fixture" (default, sample data) or "live"
LISTINGS_PROVIDER=fixture
RENT_PROVIDER=fixture
# Live rent for the check-an-address tool only (leave RENT_PROVIDER=fixture while listings are sample data)
LOOKUP_RENT_PROVIDER=
RATE_PROVIDER=fixture

# RENT_PROVIDER=housecanary needs the first two. RATE_PROVIDER=bankingbridge needs the next two (adapter contract is assumed, see src/lib/providers/bankingbridge.ts).
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=
BANKINGBRIDGE_API_URL=
BANKINGBRIDGE_API_KEY=
# Credit score assumed when pricing a public search. Placeholder until Griffin sets the marketing scenario.
PRICING_CREDIT_SCORE=740
# Not wired yet
CONSTELLATION_API_KEY=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required in the footer before launch. Not set means it is omitted.
NEXT_PUBLIC_NMLS=
# Griffin application URL shown after a lead is submitted (optional)
NEXT_PUBLIC_PREQUAL_URL=

# Demo mode is on unless this is "false": noindex, sample-data banner, leads not stored
NEXT_PUBLIC_DEMO_MODE=true
# Where leads go (POSTed as JSON). Required in production; serverless hosts have no durable disk.
LEAD_WEBHOOK_URL=
